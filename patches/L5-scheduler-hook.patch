+//                     `if endActiveTs > 0 && endActiveTs <= lastFireUnix { ... }`
+//
+// 下面这几条直接调 processEndActive / processExpiry，**绕过了 scheduleLoop**，
+// 于是看不到守卫、断言失败。⚠️ 这是「测错了层」，不是「3.40 不安全」——
+// 不要据此判定需要把补丁 06 移植回来。
+//
+// 正确的重写方式是驱动 scheduleLoop 而不是直接调投递方法，那正是 S1 哨兵的形态。
+//
+// 另两条（ExpiryFutureGuard / PagedScanSkipsOnDelete）依赖 3.32 的日志信号
+// （"Setting timer to run expiry function"），3.40 完全没有那些日志。
+// spec D9 要求 L5 加回等价观测信号 —— 那是 **Task 10** 的工作，加回之后再重写这两条。
+
+func TestLeaderboardSchedulerCallbackDedup(t *testing.T) {
+	core, logs := observer.New(zapcore.DebugLevel)
+	logger := zap.New(core)
+	cache := newTestLeaderboardCache(logger)
+	now := time.Now().UTC().Unix()
+	cache.Insert("far", true, 0, 0, "0 0 1 1 *", "{}", now, false)
+
+	ls := newTestScheduler(logger, cache)
+	// processEndActive 在 fnTournamentEnd 为 nil 时会提前 return，够不到去重。
+	ls.fnTournamentEnd = func(ctx context.Context, tournament *api.Tournament, end, reset int64) error {
+		return nil
+	}
+	defer stopTestScheduler(ls)
+
+	T := time.Unix(now, 0).UTC()
+	ls.processEndActive(T, []string{"far"})
+	ls.processEndActive(T, []string{"far"}) // 同一时刻重复投递
+
+	entries := logs.FilterMessage("Leaderboard scheduler end active").All()
+	require.Len(t, entries, 1,
+		"同一时刻被投递两次，回调只应执行一次 —— 这是 `02` 安全论证所依赖的唯一兜底，"+
+			"它失效意味着重复发奖（发奖路径零幂等、金币不可逆）")
+}
