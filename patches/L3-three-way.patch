+				Port:        uint32(portValue),
+				Role:        v.Role(),
+				Status:      int32(v.Status()),
+				Weight:      v.Weight(),
+				Balancer:    int32(v.Balancer()),
+				AllowStream: v.AllowStream(),
+			})
+		}
+		return true
+	})
+	return services
