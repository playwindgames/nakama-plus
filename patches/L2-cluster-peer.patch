+			zap.String("node", b.Node),
+			zap.Int64("version", b.Version),
+			zap.Bool("to_queue", toQueue),
+			zap.Int("channel_capacity", cap(s.binaryLogBroadcastChan)))
+		// Consider implementing metrics to track dropped binary log messages
+	}
+}
