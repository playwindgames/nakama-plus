+	s, e1 := endingToString(c, "bad RFC3597 Rdata")
+	if e1 != nil {
+		return e1
+	}
+	if rdlength*2 != len(s) {
+		return &ParseError{"", "bad RFC3597 Rdata", l}
+	}
+	rr.Rdata = s
+	return nil
