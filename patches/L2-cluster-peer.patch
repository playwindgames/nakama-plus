+
+	for k, v := range extract.Presences {
+		m.Presences[k] = &MatchmakerPresence{
+			UserId:    v.UserId,
+			SessionId: v.SessionId,
+			Username:  v.Username,
+			Node:      v.Node,
+			SessionID: uuid.FromStringOrNil(v.SessionId),
+		}
+	}
+	return m
