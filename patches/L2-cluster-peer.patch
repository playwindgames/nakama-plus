+	if err == nil {
+		return object, err
+	}
+
+	// Unable to find in cache, try to load it from load function
+	cacheKey := c.getCacheKey(key)
+	if v, ok := c.setCache.Load(cacheKey); ok {
+		return v.(T), nil
+	}
